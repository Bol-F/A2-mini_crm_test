# Optional path to the persistent SQLite file. Relative paths use the repository working directory.
DATABASE_PATH=crm.sqlite3

# Production-only Supabase Postgres connection URL. When set, it takes precedence over DATABASE_PATH.
DATABASE_URL=

# Comma-separated browser origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
